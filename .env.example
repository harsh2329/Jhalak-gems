# Required for database-backed production use
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jhalak_gems?schema=public"

# Razorpay: create keys in the merchant dashboard. Never expose secrets in browser code.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Media storage (choose Cloudinary or S3-compatible provider)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Shipping provider credentials, after merchant onboarding
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# Store configuration
NEXT_PUBLIC_STORE_NAME="Jhalak Gems"
NEXT_PUBLIC_STORE_CITY="Chandkheda, Ahmedabad"
NEXT_PUBLIC_STORE_PHONE=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
